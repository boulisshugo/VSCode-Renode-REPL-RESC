/* A small Cortex-M platform, used for the README preview. */

using "platforms/cpus/cortex-m4.repl"

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0
    systickFrequency: 64_000_000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x40000

uart0: UART.PL011 @ sysbus 0x40011000
    IRQ -> nvic@5

spi0: SPI.GenericSPI @ sysbus <0x40013000, +0x400>
    IRQ -> nvic@35 | dma@2
    mode: TransferMode.FullDuplex
    enabled: true

gpio: GPIOPort.GenericGpio @ sysbus 0x40020000
    [0-3] -> nvic@[6, 7, 8, 9]
    numberOfPins: 32

fault: Python.PythonPeripheral @ sysbus 0x40030000
    script: '''request.Value = 0xDEADBEEF'''

sysbus:
    init:
        Tag <0x40040000, 0x1000> "RESERVED"   # unmapped in this build
