{
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ]
  ],
  "colorizedBracketPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "<",
      "close": ">",
      "notIn": [
        "comment",
        "string"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "comment",
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "<",
      ">"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "folding": {
    "offSide": true
  },
  "indentationRules": {
    "increaseIndentPattern": "^(?![ \\t])[A-Za-z_][A-Za-z0-9_]*[ \\t]*:.*$|^[ \\t]*(?:init|reset)(?:[ \\t]+add)?[ \\t]*:[ \\t]*$|\\{[^}\"']*$",
    "decreaseIndentPattern": "^[ \\t]*\\}"
  },
  "onEnterRules": [
    {
      "beforeText": "^[ \\t]*//.*$",
      "action": {
        "indent": "none"
      }
    }
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
